#!/usr/bin/env python3
"""
ai_emotion_robot 主程序入口
"""

import sys
import signal
import time
import logging
from config import Config

# 配置日志
logging.basicConfig(
    level=Config.LOG_LEVEL,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)

# 导入模块
from vision import VisionModule
from audio import AudioController
from communication import CommController
from fusion import FusionModule
from decision import DecisionController

# 全局退出标志
shutdown_flag = False

def signal_handler(sig, frame):
    global shutdown_flag
    logger.info("收到退出信号，正在清理资源...")
    shutdown_flag = True

def main():
    """主函数"""
    global shutdown_flag
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)

    logger.info("=" * 50)
    logger.info("AI 情感机器人启动中...")
    logger.info("=" * 50)

    # 初始化各模块
    logger.info("初始化视觉模块...")
    vision = VisionModule(Config)
    
    logger.info("初始化语音模块...")
    audio = AudioController(Config)
    
    logger.info("初始化通信模块...")
    comm = CommController(Config)
    
    logger.info("初始化融合模块...")
    fusion = FusionModule(vision, audio, comm, Config)
    
    logger.info("初始化决策模块...")
    decision = DecisionController(Config)

    # 启动服务
    logger.info("启动视觉服务...")
    if not vision.start():
        logger.warning("视觉服务启动失败，将继续运行（无视觉输入）")
    
    logger.info("启动语音服务...")
    if not audio.start():
        logger.warning("语音服务启动失败，将继续运行（无语音输入）")
    
    logger.info("启动通信服务...")
    if not comm.start():
        logger.warning("通信服务启动失败，将继续运行（无健康数据输入）")
    
    logger.info("所有服务已启动，进入主循环")
    logger.info("=" * 50)

    try:
        while not shutdown_flag:
            # 获取融合后的用户状态
            state = fusion.get_user_state()
            
            # 只在有变化时决策
            if state['has_face'] or state['speech_has_new'] or state['is_finger_detected']:
                actions = decision.decide(state)
                
                for action in actions:
                    if action['type'] == 'oled':
                        # 通过通信模块发送 OLED 指令
                        comm.send_oled_emotion(
                            action['emotion'],
                            action.get('confidence', 75)
                        )
                        logger.debug(f"发送 OLED 指令: {action['emotion']}")
                        
                    elif action['type'] == 'oled_text':
                        # 通过通信模块发送 OLED 文本指令
                        comm.send_oled_text(
                            action['text'],
                            action.get('x', 0),
                            action.get('y', 0)
                        )
                        logger.debug(f"发送 OLED 文本: {action['text']}")
                        
                    elif action['type'] == 'speak':
                        # 本地语音播放
                        audio.respond(action['text'])
                        logger.debug(f"语音播放: {action['text'][:50]}...")
                        
                    elif action['type'] == 'servo':
                        # 通过通信模块发送舵机指令
                        comm.send_servo_move(
                            action.get('servo_id', 0),
                            action.get('angle', 90),
                            action.get('speed', 5)
                        )
                        logger.debug(f"发送舵机指令: id={action.get('servo_id', 0)}, angle={action.get('angle', 90)}")
                        
                    elif action['type'] == 'wait':
                        time.sleep(action.get('duration', 0.1))
            
            # 短暂休眠，避免 CPU 过载
            time.sleep(0.05)

    except KeyboardInterrupt:
        logger.info("收到键盘中断")
    except Exception as e:
        logger.error(f"主循环异常: {e}", exc_info=True)
    finally:
        logger.info("正在清理资源...")
        
        # 停止服务
        vision.stop()
        audio.stop()
        comm.stop()
        
        logger.info("系统已安全退出")

if __name__ == "__main__":
    main()